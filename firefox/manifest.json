{
    "manifest_version": 2,
    "name": "Halon",
    "version": "1.0.0",
    "description": "Slate and blue, one accent, hairline structure. WCAG 2.1 AA in both schemes.",
    "browser_specific_settings": {
        "gecko": {
            "id": "halon@halon.theme"
        }
    },
    "icons": {
        "48": "icon.svg",
        "96": "icon.svg"
    },
    "theme": {
